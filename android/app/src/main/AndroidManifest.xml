<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links: makes the OS route links to this domain
                 (e.g. the magic-link email's callback URL) straight into
                 this app instead of the system browser. autoVerify="true"
                 tells Android to check /.well-known/assetlinks.json on the
                 domain at install time to confirm this app is the real
                 owner before it takes over — that file has to match this
                 app's signing certificate, which means switching from the
                 debug keystore to a release keystore later requires
                 updating assetlinks.json's fingerprint too. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="chess-kingdom-adventure-opal.vercel.app" />
            </intent-filter>

            <!-- Custom scheme for the magic-link sign-in flow specifically.
                 The App Links filter above can't handle it: the actual
                 email link points at Supabase's own domain first (for
                 token verification), and only Supabase's server redirects
                 to our domain afterward — Android only intercepts the
                 FIRST tap of an external link, so by the time our domain
                 shows up mid-redirect-chain inside Chrome, App Links never
                 gets a chance to claim it. A custom scheme sidesteps this:
                 Chrome can't handle a non-http(s) scheme at all, so Android
                 is forced to hand it straight to whichever app registered
                 it — no domain-ownership proof needed, unlike App Links.
                 See CapacitorDeepLinkHandler for what receives this. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="chesskingdom" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
